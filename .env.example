# Server Configuration
PORT=3000
HOST=0.0.0.0
AGENT_NAME=Pi-Durable-Coding-Agent

# LLM Configuration (OpenAI, Gemini, OpenRouter, Groq, Ollama)
# If using Gemini:
GEMINI_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# If using OpenAI:
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Distributed Durability & Worktree
DATA_DIR=./data
WORKTREES_DIR=./worktrees
LEASE_DEFAULT_SECONDS=120
MAX_TURNS_PER_TASK=50
