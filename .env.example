# Server Configuration
PORT=3000
HOST=0.0.0.0
AGENT_ID=worker-1
AGENT_NAME=Pi-Durable-Execution-Worker
CONCURRENCY=4

# GitHub CLI Authentication
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# System Prompt Customization (Optional)
# SYSTEM_PROMPT="Always write strict TypeScript with unit tests"
# SYSTEM_PROMPT_FILE=./custom_prompt.txt

# LLM Configuration (OpenAI-compatible)
LLM_BASE_URL=https://ai.hajid.dev/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=builder

# 9Router & Web Intelligence Configuration (Optional)
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=
WEB_SEARCH_MODEL=tavily/search
WEB_FETCH_MODEL=jina/reader

# Storage & Durability
DATA_DIR=./data
WORKTREES_DIR=./worktrees
LEASE_DEFAULT_SECONDS=120
MAX_TURNS_PER_TASK=40
